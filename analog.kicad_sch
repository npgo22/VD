	(text "M2 - GND disables hamming mode in messages\nM1 - GND sets word length to 24b (full resolution)\nM0 - 3.3V sets async interrupt mode (operates as a normal ADC)"
		(exclude_from_sim no)
		(at 193.802 98.806 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "03a4bdd5-5f9e-4a54-8fdb-4aea554a9337")
	)
	(text "c0g preferred\nf_c is 1/(2*pi*2R*C) = 79.6 kHz\n\nas for modulator:\nmratio = 4.096 MHz / 79.6 kHz - 51.5\nso on log scale thats 34.2 dB attenuation\n\nbut at 1 kSPS thats 500 Hz / 79.6 kHz - 0.0063"
		(exclude_from_sim no)
		(at 59.69 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0c84f036-20a8-457d-b4a1-5438a8687eb0")
	)
	(text "Negative charge pump disabled\nUsable voltage range is 0 to 3.3V"
		(exclude_from_sim no)
		(at 125.73 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1ba44f71-526c-4ecf-983b-1c966ab8c814")
	)
	(text "Resistors should be 0.1% at worst"
		(exclude_from_sim no)
		(at 36.83 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "21bea784-5db3-4356-a71b-d4af0703d0e9")
	)
	(text "Max power is (0.022^2)*100 = 0.0484W"
		(exclude_from_sim no)
		(at 39.37 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "406d210e-c845-4938-bede-77cf8521f3f2")
	)
	(text "Normal range:\n0 mA open/fault-low  -> 0.000 V\n4 mA                 -> 0.400 V = 0 psi\n20 mA                -> 2.000 V = max psi\n21.5 mA overrange    -> 2.150 V\nPressure scale:\n16 mA span = 5000 psi\n3.2 uA/psi\n100 ohm * 3.2 uA/psi = 320 uV/psi\n0.1 psi = 32 uV\n\nWith internal VREF = 2.442 V, gain 1"
		(exclude_from_sim no)
		(at 217.17 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "78e70dd5-bc97-4595-90de-99bf7d53c09c")
	)
	(text "ANALOG FRONTEND"
		(exclude_from_sim no)
		(at 45.72 17.78 0)
