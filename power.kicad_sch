	(text "The idea here is that a NC emergency\nstop button will be used to toggle\nthe optocouplers driving the inputs of\nthe drivers. When this line is cut,\nthe pulldowns on the driver side take over,\nand the system pulls all outputs low,\nclosing all solenoids.\n\nThis emulates the desired bus switch \nfunctionality of the original test\nstand electronics while enabling galvanic\nisolation between the +12V and +3.3V rails."
		(exclude_from_sim no)
		(at 69.596 79.248 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c641b279-ce2e-4ff9-b05f-2a3c311f066a")
	)
	(text "POWER INPUT"
		(exclude_from_sim no)
		(at 46.482 25.4 0)
		(effects
			(font
				(size 3.81 3.81)
			)
		)
		(uuid "e66d0ec2-ad83-412c-b2eb-d3c36da71f72")
	)
	(text "12*0.9 = 10.8A (13.2A peak) possible\nbut set to 10 since it is a more common\nfuse size (standard 10A automotive)"
		(exclude_from_sim no)
		(at 58.42 54.356 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e7b36bce-1627-40b2-9f1f-e6f54abbb0df")
	)
